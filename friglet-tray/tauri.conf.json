{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "friglet-tray",
  "version": "0.1.0",
  "identifier": "dev.setor.friglet.tray",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Friglet Status",
        "width": 420,
        "height": 600,
        "minWidth": 340,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
